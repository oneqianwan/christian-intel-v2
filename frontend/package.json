{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:watch-alert-contract": "node scripts/verify-watch-alert-contract.mjs",
    "check:watchlist-ui": "node scripts/verify-watchlist-ui.mjs",
    "check:alerts-ui": "node scripts/verify-alerts-ui.mjs",
    "check:watch-alert-auth": "node scripts/verify-watch-alert-auth-boundary.mjs",
    "check:watch-alert-user-auth": "node scripts/verify-watch-alert-user-auth.mjs",
    "check:auth-ui": "node scripts/verify-auth-ui.mjs",
    "lint": "oxlint",
    "test:auth": "vitest run src/auth/__tests__ src/pages/__tests__",
    "test:watch-alert-user-auth": "vitest run src/features/watchAlerts/__tests__ src/api/__tests__/watchAlertsAuth.test.ts src/components/__tests__/WatchButton.auth.test.tsx src/components/__tests__/NotificationBell.auth.test.tsx src/pages/__tests__/WatchlistPage.auth.test.tsx src/pages/__tests__/AlertsPage.auth.test.tsx",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^27.0.0",
    "oxlint": "^1.69.0",
    "playwright": "^1.61.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^3.2.4"
  }
}
